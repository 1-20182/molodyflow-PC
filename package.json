{
  "name": "MelodyFlow",
  "version": "0.1.0",
  "private": true,
  "main": "main/main.js",
  "scripts": {
    "dev": "concurrently \"pnpm dev:vite\" \"pnpm dev:electron\"",
    "dev:vite": "vite renderer/vite.config.js",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build renderer/vite.config.js && electron-builder",
    "pack": "electron-builder --win portable",
    "dist": "electron-builder --win nsis",
    "lint": "echo 'lint ok'"
  },
  "build": {
    "appId": "com.melodyflow.app",
    "productName": "MelodyFlow",
    "directories": {
      "output": "release-latest"
    },
    "files": [
      "main/**/*",
      "renderer/dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "renderer/src/assets/app-icon.jpg"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MelodyFlow"
    },
    "portable": {
      "artifactName": "MelodyFlow-${version}-portable.exe"
    }
  },
  "dependencies": {
    "@melodyflow/shared-core": "workspace:*",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.1.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  }
}
